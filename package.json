{
  "name": "shanthi-electricals-pos",
  "productName": "Shanthi Electricals POS",
  "version": "1.5.0",
  "private": true,
  "description": "Shanthi Electricals desktop POS with React, Express, Electron and MySQL/MariaDB",
  "author": "Shanthi Electricals",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "seed": "npm --prefix backend run seed",
    "setup": "npm install",
    "db:check": "npm --prefix backend run db:check",
    "db:migrate": "npm --prefix backend run db:migrate",
    "test": "npm --prefix backend run test && node --test electron/test/*.test.cjs",
    "db:doctor": "npm --prefix backend run db:doctor",
    "db:setup": "npm run db:check && npm run db:migrate && npm run db:doctor && npm run seed",
    "verify": "npm run test && npm run build",
    "desktop:start": "npm run build && electron .",
    "desktop:package": "npm run verify && electron-forge package",
    "desktop:make": "npm run verify && electron-forge make",
    "desktop:make:win": "npm run verify && electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nanoid": "^3.3.7",
    "pdfkit": "^0.15.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "electron": "43.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
