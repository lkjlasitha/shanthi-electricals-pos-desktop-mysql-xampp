# Server
PORT=4000
NODE_ENV=development

# Database (MongoDB)
# Local development (a plain local mongod is fine for everyday dev, but see
# the note below about transactions):
#   MONGODB_URI=mongodb://127.0.0.1:27017/electro_pos
# MongoDB Atlas (recommended -- the free M0 tier is always a replica set):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/electro_pos
#
# IMPORTANT: this app uses multi-document transactions (e.g. a sale + its
# stock deduction + its payment succeed or fail together). That requires
# MongoDB to be running as a replica set. A single plain `mongod` is NOT a
# replica set by default and will error on checkout/purchase/etc. MongoDB
# Atlas's free tier always is one, so it works with zero extra setup. For
# local development against a plain mongod, either initialize it as a
# single-node replica set (`rs.initiate()` in mongosh), or point MONGODB_URI
# at an Atlas cluster instead.
MONGODB_URI=mongodb+srv://shanthiPOS:vSB3MsycutUqQUqG@shanthaelectricals.pzjeaz6.mongodb.net/?appName=shanthaElectricals

# Auth
JWT_SECRET=56f119000883e86f71125a50fca542e75957c7f809f55dc5f5b76a3f62c2967308cb2bd97af75f1e6b2ea7f097be9ddcca2643125a499bc028f6c836bc688d35
JWT_EXPIRES_IN=12h

# Business defaults (Sri Lanka)
DEFAULT_CURRENCY_CODE=LKR
DEFAULT_CURRENCY_SYMBOL=Rs.
DEFAULT_COUNTRY=Sri Lanka
DEFAULT_TIMEZONE=Asia/Colombo
DEFAULT_DATE_FORMAT=DD/MM/YYYY

# Seed admin (created by `npm run seed`)
SEED_ADMIN_NAME=Shop Owner
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_PHONE=+94 77 123 4567
